CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_DEVTMPFS=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y

CONFIG_NOMOUNT=y

# Requested for DroidSpaces user-namespace sandboxing.
CONFIG_USER_NS=y
